##########################################################################
##################### Section 1 -- BASIC COMMANDS ########################
##########################################################################

1.
  hostname # display server hostname
2.
  whoami # display loggedin username
3.
   id # display logged in user's detail
4.
   ip link # display the network card hardware information
5.
    ip addr # display ip address
6.
   ip route | grep default # display default gateway
7.
   lsblk # list block device information, ideal for collecting disk details
8.
    df -h #  disk free -- get file system information , -h for human friendly output
9.
   free -h | get memory usage information
10.
   sudo su - | escalate to root user

##############################################################################
###################### File / Directory Management ###########################
##############################################################################
1.
  touch testfile.txt # create empty file named testfile.txt or update file timestamp if file already exist
2.
  echo Hello # output hello to screen
  echo Hello > testfile.txt # writes Hello to testfile.txt, create testfile.txt if does not exist
  echo HEllo >> testfile.txt # append HEllo to testfile.txt , create testfile.txt if does not exist
  name="Mohammed"
  echo $name
  echo $HOME
3. cat testfile.txt # display the content of the file testfile.exe on the screen
4. head /etc/passwd # display first 10 lines of the file
   head -n 5 /etc/passwd #display first 5 lines of the file
5. tail /etc/passwd # display last 10 lines of the file
   tail -n 5 /etc/passwd #display last 5 lines of the file
   tail -f /var/log/nginx/access.log # as new lines added to access.log file, it will display immediately

